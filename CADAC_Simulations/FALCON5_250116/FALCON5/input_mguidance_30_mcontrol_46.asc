TITLE input_mguidance_30_mcontrol_46.asc
//Line-guidance lateral, mguidance 30 
//Controllers lateral acceleration and altitude, mcontrol 46
//Two waypoints

OPTIONS y_scrn y_events n_tabout y_plot y_doc n_csv 
MODULES
	environment		def,exec	
	kinematics		def,init,exec
	aerodynamics	def,exec
	propulsion		def,init,exec
	guidance		def,exec
	control			def,exec
	forces			def,exec
	newton			def,init,exec
	intercept		def,exec
END
TIMING
	scrn_step 5
	plot_step 0.1
	int_step 0.05
END
VEHICLES 1
	PLANE  FALCON5
			sbel1  0    //Vehicle initial north position - m  module newton
			sbel2  0    //Vehicle initial east position - m  module newton
			sbel3  -3000    //Vehicle initial down position - m  module newton
			psivlx  0    //Vehicle heading angle - deg  module newton
			thtvlx  0    //Vehicle flight path angle - deg  module newton
			dvbe  200    //Vehicle speed - m/s  module newton
		//aerodynamics
			AERO_DECK Falcon5_aero_deck.asc
			area  27.87    //Aerodynamic reference area - m^2  module aerodynamics
			mac  35    //'int' Mean aerodynamic chord flag - ND  module aerodynamics
			alpposlimx  15    //Angle of attack positive limiter - deg  module control
			alpneglimx  -10    //Angle of attack negative limiter - deg  module control
		//Propulsion and mass properties
			PROP_DECK Falcon5_prop_deck.asc
			mprop  4    //'int' Mode switch - ND  module propulsion
			mach_com  0.6    //Commanded Mach number - ND  module propulsion
			mass_init  12701    //Initial vehicle mass - kg  module propulsion
			fuel_init  4461    //Initial fuel - kg  module propulsion
			gfthm  893620    //Gain of Mach hold loop - N  module propulsion
			tfth  1    //Time constant of Mach hold loop - s  module propulsion
		//guidance
			mguidance  30    //'int' Switch for guidance options - ND  module guidance
			line_gain  1    //Line guidance gain - 1/s  module guidance
			nl_gain_fact  .6    //Nonlinear gain factor - ND  module guidance
			decrement  1000    //distance decrement - m  module guidance
		//autopilot
			mcontrol  46    //'int' Mode switch - ND  module control
		//loadfactor controller
			anposlimx  3    //Positive load factor limiter - g's  module control
			anneglimx  -1    //Negative load factor limiter - g's  module control
			gacp  10    //Root locus gain of accel loop - rad/s^2  module control
			ta  0.8    //Ratio of prop/integral gains. If>0, P-I engaged  module control
		//lateral acceleration controller
			alcomx  0.5    //Lateral acceleration command - g's  module control
			gcp  2    //Lateral roll gain - rad  module control
			allimx  1    //Lateral acceleration limiter - g's  module control
		//bank-angle controller
			phicx  0    //Bank angle command- deg  module control
			philimx  70    //Bank angle command limiter - deg  module control
			tphi  1    //Time constant of bank angle response - sec  module control
		//altitude controller
			altcom  3500    //Altitude command  - m  module control
			altdlim  50    //Altitude rate limiter - m/s  module control
			gh  0.3    //Altitude gain - g/m  module control
			gv  1.0    //Altitude rate gain - g/(m/s)  module control
		//Waypoint #1
			swel1  5000    //Waypoint north - m  module guidance
			swel2  1000    //Waypoint east - m  module guidance
			psiflx  10    //Heading line-of-attack angle - deg  module guidance
			IF   wp_flag = -1
			//Waypoint #2
				swel1  12000    //Waypoint north - m  module guidance
				swel2  3000    //Waypoint east - m  module guidance
				psiflx  30    //Heading line-of-attack angle - deg  module guidance
				altcom  5000    //Altitude command  - m  module control
				stop_run  1    //'int' if 1 stops run - ND  module intercept
			ENDIF
	END
ENDTIME 80
STOP
