TITLE input_mcontrol=11.asc
//Heading and flight path angle control
//Mach hold at 0.6

OPTIONS y_scrn y_events y_doc y_tabout y_plot n_csv
MODULES
	environment		def,exec	
	kinematics		def,init,exec
	aerodynamics	def,exec
	propulsion		def,init,exec
	control			def,exec
	forces			def,exec
	newton			def,init,exec
END
TIMING
	scrn_step 5
	plot_step 0.1
	int_step 0.05
END
VEHICLES 1
	PLANE  FALCON5
			sbel1  0    //Vehicle initial north position - m  module newton
			sbel2  0    //Vehicle initial east position - m  module newton
			sbel3  -3000    //Vehicle initial down position - m  module newton
			psivlx  0    //Vehicle heading angle - deg  module newton
			thtvlx  0    //Vehicle flight path angle - deg  module newton
			dvbe  200    //Vehicle speed - m/s  module newton
		//aerodynamics
			AERO_DECK Falcon5_aero_deck.asc
			area  27.87    //Aerodynamic reference area - m^2  module aerodynamics
			mac  35    //'int' Mean aerodynamic chord flag - ND  module aerodynamics
			alpposlimx  15    //Angle of attack positive limiter - deg  module control
			alpneglimx  -10    //Angle of attack negative limiter - deg  module control
		//Propulsion and mass properties
			PROP_DECK Falcon5_prop_deck.asc
			mprop  4    //'int' Mode switch - ND  module propulsion
			mach_com  0.6    //Commanded Mach number - ND  module propulsion
			mass_init  12701    //Initial vehicle mass - kg  module propulsion
			fuel_init  4461    //Initial fuel - kg  module propulsion
			gfthm  893620    //Gain of Mach hold loop - N  module propulsion
			tfth  1    //Time constant of Mach hold loop - s  module propulsion
		//autopilot
			mcontrol  11    //'int' Mode switch - ND  module control
		//bank-angle controller
			philimx  70    //Bank angle command limiter - deg  module control
			tphi  0.5    //Time constant of bank angle response - sec  module control
		//heading controller
			psivlcx  10    //Commanded heading angle - deg  module control
			gain_psivg  12.0    //Heading angle hold control gain - ND  module control
		//flight path angle controller
			gain_thtvg  30    //Flight path angle hold control gain - g/deg  module control
			thtvgcx  5    //Commanded flight path angle - deg  module control
	END
ENDTIME 60
STOP
