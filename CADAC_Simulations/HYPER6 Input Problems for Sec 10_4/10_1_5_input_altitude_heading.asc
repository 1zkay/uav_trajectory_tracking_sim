TITLE input_altitude_heading.asc: Heading and altitude autopilot
//
// First altitude increase by 50 m followed by 30 deg heading change
//  
OPTIONS y_scrn n_comscrn n_events y_doc y_tabout y_plot n_stat n_merge n_traj 
MODULES
	kinematics		def,init,exec
	environment		def,init,exec
	aerodynamics	def,init,exec
	propulsion		def,init,exec
	ins				def,init,exec
	control         def,exec
	actuator		def,exec
	forces			def,exec
	newton			def,init,exec
	euler			def,init,exec
END
TIMING
	scrn_step 5
	plot_step .1
	int_step 0.01
END
VEHICLES 1
	HYPER6 Hypersonic Vehicle
			lonx  10    //Vehicle longitude - deg  module newton
			latx  10    //Vehicle latitude - deg  module newton
			alt  10000    //Vehicle altitude - m  module newton
			dvbe  1000    //Vehicle geographic speed - m/s  module newton
			alpha0x  2.5    //Initial angle-of-attack - deg  module newton
			thtbdx  2.5    //Pitching angle of veh wrt geod coord - deg  module kinematics
		//aerodynamics
			maero  1    //'int' =0: no aero; =1:GHAME; =2:transfer vehicle  module aerodynamics
			AERO_DECK ghame6_aero_deck.asc
			alpplimx  21    //Maximum positive alpha permissible - deg  module aerodynamics
			alpnlimx  -3    //Minimum neg alpha permissible (with neg sign) - deg  module aerodynamics
			strct_pos_limitx  3    //Pos structural limiter - g's  module aerodynamics
			strct_neg_limitx  -2    //Neg structural limiter (with neg sign) - g's  module aerodynamics
		//propulsion
			PROP_DECK ghame6_prop_deck.asc
			mprop  2    //'int' =0:none; =1:hyper; =2:hyper-auto; =3(LTG)&4(input):rocket  module propulsion
			vmass0  136077    //Initial gross mass - kg  module propulsion
			fmass0  81646    //Initial fuel mass in stage - kg  module propulsion
			qhold  200000    //Dynamic pressure hold command - Pa  module propulsion
			tq  1    //Autothrottle time constant - sec  module propulsion
			acowl  27.87    //Cowl area of engine inlet - m^2  module propulsion
			thrtl_idle  .05    //Idle throttle - ND  module propulsion
			thrtl_max  2    //Max throttle - ND  module propulsion
		//actuator
			mact  2    //'int' =0:no dynamics, =2:second order  module actuator
			dlimx  20    //Control fin limiter - deg  module actuator
			ddlimx  400    //Control fin rate limiter - deg/s  module actuator
			wnact  50    //Natural frequency of actuator - rad/s  module actuator
			zetact  0.7    //Damping of actuator - ND  module actuator
		//autopilot
			maut  45    //'int' maut=|mauty|mautp| see table  module control
			dalimx  20    //Aileron limiter - deg  module control
			delimx  20    //Elevator limiter - deg  module control
			drlimx  20    //Rudder limiter - deg  module control
		//roll control
			phicomx  0    //Roll angle command - deg  module control
			philimx  60    //Roll angle limiter - deg  module control
			wrcl  8    //Freq of roll closed loop complex pole - rad/s  module control
			zrcl  .9    //Damping of roll closed loop pole - ND  module control
		//SAS
			zetlagr  1.1    //Desired damping of closed rate loop ND  module control
		//pitch acceleration control
			ancomx  1    //Pitch acceleration command - g's  module control
			gainp  -.01    //Proportional gain in pitch acceleration loop - s^2/m  module control
			zaclp  1.2    //Damping of accel close loop complex pole - ND  module control
			waclp  3    //Nat freq of accel close loop complex pole - rad/s  module control
			paclp  5    //Close loop real pole - ND  module control
		//altitude controller
			altcom  10000    //Altitude command - m  module control
			gainalt  0.5    //Altitude gain - 1/s  module control
			gainaltrate  0.5    //Altitude rate gain - 1/s  module control
		//heading controller
			facthead  -0.95    //Fact to reduce heading gain gainpsi*(1+facthead) - ND  module control
			IF time > 20
				altcom  10050    //Altitude command - m  module control
			ENDIF
			IF time > 40
				psivdcomx  30    //Heading command - deg  module control
			ENDIF
	END
ENDTIME 100
STOP
