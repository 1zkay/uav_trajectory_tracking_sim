TITLE input_Demo_4_6_point_guid.asc

Demo 4.6 Point guidance against WSMR coordinates

OPTIONS y_scrn y_events y_plot y_traj n_merge y_doc 
MODULES
	environment		def,init,exec
	aerodynamics	def,exec	
	propulsion		def,init,exec	
	forces			def,exec	
	newton			def,init,exec	
	guidance		def,exec
	control			def,exec	
	intercept		def,exec
END
TIMING
	scrn_step 10
	plot_step 1
	traj_step 1
	int_step 0.05
END
VEHICLES 1
	HYPER5 RR3X
		//Initial conditions
			lonx  -106.3    //Vehicle longitude - deg  module newton
			latx  32    //Vehicle latitude - deg  module newton
			alt  20000    //Vehicle altitude - m  module newton
			psivgx  0    //Vehicle heading angle - deg  module newton
			thtvgx  0    //Vehicle flight path angle - deg  module newton
			dvbe  1181    //Vehicle speed - m/s  module newton
			alphax  0    //Angle of attack - deg  module control
			phimvx  0    //Bank angle - deg  module control
		//phimvx  7    //Bank angle - deg  module control
		//Aerodynamics
			AERO_DECK hyper5_aero_deck.asc
			area  11.6986    //Aerodynamic reference area - m^2  module aerodynamics
			alpposlimx  6    //Angle of attack positive limiter - deg  module control
			alpneglimx  -4    //Angle of attack negative limiter - deg  module control
		//Mass properties 
			mprop  0    //'int' =0:none;=1:fixed-phi;=2:auto-phi;=3:keep-phi  module propulsion
			mass0  1352    //Initial gross mass - kg  module propulsion
		//autopilot
			mcontrol  44    //'int' Mode switch - ND  module control
		//lateral acceleration controller
			gcp  2    //Lateral roll gain - rad  module control
			allimx  1    //Lateral acceleration limiter - g's  module control
		//bank-angle controller
			philimx  70    //Bank angle command limiter - deg  module control
			tphi  1    //Time constant of bank angle response - sec  module control
		//loadfactor controller
			anposlimx  2    //Positive load factor limiter - g's  module control
			anneglimx  -2    //Negative load factor limiter - g's  module control
			gacp  10    //Root locus gain of accel loop - rad/s^2  module control
			ta  0.8    //Ratio of prop/integral gains. If>0, P-I engaged  module control
		//pitch-over point guidance
			mguidance  44    //'int' Switch for guidance options - ND  module guidance
			point_gain  0.04    //Point guidance gain - 1/s  module guidance
		//WSMR Coordinates
			wp_lonx  -106.28    //Longitude of way point - deg  module guidance
			wp_latx  33.4    //Latitude of way point - deg  module guidance
			wp_alt  1200    //Altitude of way point - m  module guidance
			IF  wp_flag = -1
				halt  1    //'int'  =0 false, =1 stops run - s  module intercept
			ENDIF
	END
END
ENDTIME 300
STOP
